# Dunst config — styled to match the Catppuccin Mocha waybar and Hyprland borders.
# Docs: man dunst / dunstrc(5)

[global]
    ### Display ###
    monitor = 0
    follow = mouse
    # Top-right, just below the waybar and aligned with its 20px side margin
    origin = top-right
    offset = (20, 56)
    width = (300, 380)
    height = (0, 160)
    notification_limit = 4
    indicate_hidden = yes
    scale = 0
    transparency = 8
    separator_height = 1
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 2
    corner_radius = 12
    sort = yes
    idle_threshold = 0

    ### Text ###
    font = CaskaydiaCove Nerd Font Propo 11
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no

    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 56

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    ### Stacking / history ###
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sticky_history = yes
    history_length = 30

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    ### Colors (default; overridden per urgency below) ###
    frame_color = "#89dceb"
    separator_color = frame

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    frame_color = "#45475a"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89dceb"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0

# Hide noisy/duplicate-prone sources if you want; examples:
# [volume-osd]
#     appname = "*volume*"
#     timeout = 1
